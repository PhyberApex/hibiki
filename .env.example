# Copy this file to .env at the repo root (same folder as package.json).

# Discord bot token (required — or set it in Settings inside the app)
DISCORD_TOKEN=

# Vision to Vibe API keys (optional — or set them in Settings inside the app).
# The active Vision Provider (Claude or OpenAI-compatible) is chosen in Settings, not via env var.
# HIBIKI_VISION_API_KEY= -- Anthropic (Claude) key
# HIBIKI_VISION_OPENAI_API_KEY= -- key for the OpenAI-compatible provider (not needed for keyless local servers)

# Storage paths (defaults below; relative to repo root or absolute)
# HIBIKI_STORAGE_PATH=storage
# HIBIKI_MUSIC_DIR=storage/music
# HIBIKI_EFFECTS_DIR=storage/effects
# HIBIKI_DATA_PATH=storage/data/hibiki.json
