{
  "name": "hibiki",
  "version": "1.3.0",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "description": "Hibiki (響) – Echoes of Adventure. Your private bard bot for Discord.",
  "author": "PhyberApex",
  "license": "MIT",
  "main": "electron/main.js",
  "config": {
    "forge": "./forge.config.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "pnpm run build && electron-forge start",
    "build": "pnpm run build:frontend && tsc --build",
    "build:frontend": "cd frontend && vite build",
    "make": "pnpm run build && electron-forge make",
    "package": "pnpm run build && electron-forge package",
    "dist": "pnpm run make",
    "dist:mac": "pnpm run make -- --platform=darwin",
    "dist:win": "pnpm run make -- --platform=win32",
    "dist:linux": "pnpm run make -- --platform=linux",
    "lint": "eslint . frontend/",
    "lint:fix": "eslint . frontend/ --fix",
    "test": "run-p test:backend test:frontend",
    "test:backend": "node --experimental-vm-modules node_modules/.bin/jest --config jest.config.js",
    "test:frontend": "cd frontend && vitest run",
    "test:watch": "node --experimental-vm-modules node_modules/.bin/jest --watch --config jest.config.js",
    "test:coverage": "run-p test:coverage:backend test:coverage:frontend",
    "test:coverage:backend": "node --experimental-vm-modules node_modules/.bin/jest --coverage --config jest.config.js",
    "test:coverage:frontend": "cd frontend && vitest run --coverage",
    "test:e2e": "cd e2e && pnpm install --frozen-lockfile && pnpm test",
    "registry:validate": "node registry/scripts/validate.mjs",
    "registry:build-index": "node registry/scripts/build-index.mjs",
    "docs": "cd docs && bundle exec jekyll serve --baseurl \"\" --livereload"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@discordjs/rest": "^2.3.0",
    "@discordjs/voice": "^0.19.0",
    "@noble/ciphers": "^2.1.1",
    "@snazzah/davey": "^0.1.10",
    "@wasm-audio-decoders/flac": "^0.2.11",
    "@wasm-audio-decoders/ogg-vorbis": "^0.1.20",
    "adm-zip": "^0.6.0",
    "discord-api-types": "^0.38.0",
    "discord.js": "^14.22.0",
    "dotenv": "^18.0.0",
    "fast-glob": "^3.3.2",
    "joi": "^18.0.2",
    "mpg123-decoder": "^1.0.3",
    "node-audio-mixer": "^2.1.0",
    "ogg-opus-decoder": "^1.7.5",
    "opusscript": "^0.1.1",
    "pinia": "^4.0.0",
    "slugify": "^1.6.6",
    "vue": "^3.5.27",
    "vue-router": "^5.0.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@electron-forge/cli": "^8.0.0",
    "@electron-forge/maker-deb": "^8.0.0",
    "@electron-forge/maker-dmg": "^8.0.0",
    "@electron-forge/maker-squirrel": "^8.0.0",
    "@electron-forge/maker-zip": "^8.0.0",
    "@electron-forge/plugin-vite": "^8.0.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/adm-zip": "^0.5.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitest/coverage-v8": "^5.0.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.0",
    "electron": "^44.0.0",
    "eslint": "^10.0.0",
    "jest": "^30.2.0",
    "jest-junit": "^17.0.0",
    "jsdom": "^30.0.0",
    "node-gyp": "^13.0.2",
    "npm-run-all2": "^9.0.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "vite": "^8.0.0",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.2.4"
  }
}
